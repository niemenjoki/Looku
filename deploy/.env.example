# Where the database is kept on the host (back this folder up).
LOOKU_DATA_DIR=./data
LOOKU_TIMEZONE=Europe/Helsinki

# Dashboard address on the host: a LAN or Tailscale address keeps it private.
LOOKU_DASHBOARD_BIND=127.0.0.1
LOOKU_DASHBOARD_PORT=8788
# Accepted Host headers, e.g. 192.168.1.10:8788 (protects against DNS rebinding).
LOOKU_API_HOSTS=
# Behind an HTTPS reverse proxy: the public address and secure cookies.
LOOKU_PUBLIC_ORIGIN=
LOOKU_COOKIE_SECURE=0

# Monthly email (optional; nothing is sent while empty).
LOOKU_SMTP_URL=
LOOKU_REPORT_FROM=
LOOKU_REPORT_TO=
LOOKU_REPORT_LANG=fi

# Cloudflare tunnel (profile "tunnel").
CLOUDFLARED_VERSION=
LOOKU_TUNNEL_TOKEN=
